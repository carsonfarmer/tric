package tric:js-fixture;

// What tric grants an app, and no more. The WASI packages are wasip3's, and wasi:keyvalue is in
// ../../../../wit/keyvalue: build.sh copies both into wit/deps. The WASI 0.2 interfaces that componentize-qjs's
// runtime itself imports are not listed here.
world app {
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;
  import wasi:cli/environment@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  include wasi:keyvalue/imports@0.2.0-draft2;
  export wasi:http/handler@0.3.0;
}
