+/// Stand-in for `Linker::define_unknown_imports_as_traps`, which since wasmtime 49 leaves a trapping definition of a
+/// resource that merely aliases an earlier one (`wasi:io/streams` `error` is `wasi:io/error` `error`) next to the real
+/// definition that shadows its original, so the instance no longer type checks. Aliases are left undefined here.
+fn trap_imports(linker: &mut Linker<Ctx>, engine: &Engine, comp: &WasmtimeComponent) -> Result<()> {
+    fn item(
+        li: &mut LinkerInstance<'_, Ctx>,
+        engine: &Engine,
+        path: &str,
+        name: &str,
+        it: ComponentItem,
+        seen: &mut Vec<ResourceType>,
+    ) -> Result<()> {
+        let full = if path.is_empty() { name.to_string() } else { format!("{path}#{name}") };
+        match it {
+            ComponentItem::ComponentFunc(f) if f.async_() => li.func_new_concurrent(name, move |_, _, _, _| {
+                let full = full.clone();
+                Box::pin(async move { Err(wasmtime::format_err!("unknown import: `{full}` has not been defined")) })
+            })?,
+            ComponentItem::ComponentFunc(_) => li.func_new(name, move |_, _, _, _| {
+                Err(wasmtime::format_err!("unknown import: `{full}` has not been defined"))
+            })?,
+            ComponentItem::ComponentInstance(i) => {
+                let mut sub = li.instance(name)?;
+                for (n, e) in i.exports(engine) {
+                    item(&mut sub, engine, name, n, e.ty, seen)?;
+                }
+            }
+            ComponentItem::Resource(r) if !seen.contains(&r) => {
+                seen.push(r);
+                li.resource(name, ResourceType::host::<()>(), |_, _| Ok(()))?;
+            }
+            ComponentItem::Component(_) | ComponentItem::Module(_) => {
+                return Err(anyhow!("unable to define import `{full}` as a trap"));
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+
+    let mut seen = Vec::new();
+    for (name, it) in comp.component_type().imports(engine) {
+        item(&mut linker.root(), engine, "", name, it.ty, &mut seen)?;
+    }
+    Ok(())
+}
